{
  "name": "kr16-debug",
  "displayName": "KR16 Debug",
  "description": "Debug KR16 programs with the KR16 DAP server",
  "version": "1.2.0",
  "publisher": "kr16",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinwross/kr16.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onDebug",
    "onDebugResolve:kr16",
    "onCommand:kr16.debug",
    "onCommand:kr16.disassembly"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kr16.debug",
        "title": "KR16: Debug Program"
      },
      {
        "command": "kr16.disassembly",
        "title": "KR16: Show Disassembly"
      }
    ],
    "menus": {
      "debug/toolbar": [
        {
          "command": "kr16.disassembly",
          "when": "debugType == 'kr16'",
          "group": "navigation"
        }
      ]
    },
    "debuggers": [
      {
        "type": "kr16",
        "label": "KR16",
        "languages": [
          "c",
          "asm"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .kex or raw image"
              },
              "port": {
                "type": "number",
                "default": 22152,
                "description": "TCP port for the KR16 DAP server"
              },
              "kr16Path": {
                "type": "string",
                "default": "kr16",
                "description": "Path to the kr16 executable"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true
              },
              "launchAdapter": {
                "type": "boolean",
                "default": true,
                "description": "Launch kr16 dap in an integrated terminal"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "kr16",
            "request": "launch",
            "name": "Debug KR16 program",
            "program": "${workspaceFolder}/build/program.kex",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "KR16: Debug program",
            "description": "Launch a KR16 program under the DAP server",
            "body": {
              "type": "kr16",
              "request": "launch",
              "name": "Debug KR16 program",
              "program": "${workspaceFolder}/build/program.kex",
              "stopOnEntry": true
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "node test/runTest.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.3"
  }
}




