{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2026",
      "displayName": "Windows x64 (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/windows-vs2026",
      "cacheVariables": {
        "KR16_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-ninja",
      "displayName": "Windows x64 (Ninja + MSVC, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KR16_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-ninja-release",
      "displayName": "Windows x64 (Ninja + MSVC, Release)",
      "inherits": "windows-ninja",
      "binaryDir": "${sourceDir}/build/windows-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux (GCC, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "KR16_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux (GCC, Release)",
      "inherits": "linux-gcc",
      "binaryDir": "${sourceDir}/build/linux-gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc-sanitize",
      "displayName": "Linux (GCC, ASan/UBSan)",
      "inherits": "linux-gcc",
      "binaryDir": "${sourceDir}/build/linux-gcc-sanitize",
      "cacheVariables": {
        "KR16_SANITIZE": "ON",
        "KR16_BUILD_UI": "OFF"
      }
    },
    {
      "name": "linux-arm64-cross",
      "displayName": "Linux ARM64 (cross, offscreen SDL3)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-arm64-cross",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-aarch64.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "KR16_BUILD_UI": "ON",
        "KR16_BUILD_TESTS": "OFF",
        "SDL_X11": "OFF",
        "SDL_WAYLAND": "OFF",
        "SDL_KMSDRM": "OFF",
        "SDL_OFFSCREEN": "ON",
        "SDL_UNIX_CONSOLE_BUILD": "ON"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux (Clang, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "KR16_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux (Clang, Release)",
      "inherits": "linux-clang",
      "binaryDir": "${sourceDir}/build/linux-clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2026-debug",
      "configurePreset": "windows-vs2026",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026",
      "configuration": "Release"
    },
    {
      "name": "windows-ninja-debug",
      "configurePreset": "windows-ninja"
    },
    {
      "name": "windows-ninja-release",
      "configurePreset": "windows-ninja-release"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "linux-gcc-sanitize",
      "configurePreset": "linux-gcc-sanitize"
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang"
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-vs2026-debug",
      "configurePreset": "windows-vs2026",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": { "jobs": 4 }
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": { "jobs": 4 }
    },
    {
      "name": "windows-ninja-debug",
      "configurePreset": "windows-ninja",
      "output": {
        "outputOnFailure": true
      },
      "execution": { "jobs": 4 }
    },
    {
      "name": "windows-ninja-release",
      "configurePreset": "windows-ninja-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": { "jobs": 4 }
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      },
      "execution": { "jobs": 4 }
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": { "jobs": 4 }
    },
    {
      "name": "linux-gcc-sanitize",
      "configurePreset": "linux-gcc-sanitize",
      "output": {
        "outputOnFailure": true
      },
      "execution": { "jobs": 4 }
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang",
      "output": {
        "outputOnFailure": true
      },
      "execution": { "jobs": 4 }
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": { "jobs": 4 }
    }
  ]
}

