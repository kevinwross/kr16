if(NOT DEFINED SOURCE_DIR)
  message(FATAL_ERROR "SOURCE_DIR is required")
endif()
file(READ "${SOURCE_DIR}/.github/workflows/release.yml" workflow)
foreach(needle "kr16-debug.vsix" "SHA256SUMS" "name: KR16-vscode" "needs: [windows, linux-x64, linux-arm64, vscode]")
  string(FIND "${workflow}" "${needle}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "release workflow is missing ${needle}")
  endif()
endforeach()
message(STATUS "release workflow publishes VSIX and SHA256SUMS")
